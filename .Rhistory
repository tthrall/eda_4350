#| label: CRAN-libraries
library(assertthat)
library(here)
library(latex2exp)
library(tidyverse)
library(tinytex)
library(UsingR)
#| label: local-source
# source(here("code", "xxx.R"))
#| label: father-son-ht
father_son_ht <- UsingR::father.son |>
as_tibble() |>
rename(father = fheight, son = sheight)
#| label: fig-father-son-ht
#| fig-cap: "XXX"
g_father_son_ht <- father_son_ht |>
ggplot(mapping = aes(x = father, y = son)) +
geom_point()
g_father_son_ht
#| label: f_mpt
# f_ivl: successive 2-inch intervals of father heights
# f_mpt: mid-point of each interval
father_son_ht <- father_son_ht |>
mutate(
f_ivl = cut(father, seq(58, 76, 2)),
f_mpt = (2 * ceiling(father/2)) - 1
)
#| label: g_f_mpt
g_f_mpt <- father_son_ht |>
filter(! is.na(f_mpt)) |>
ggplot(mapping = aes(
x = f_mpt |> as_factor(),
y = son
)) +
geom_boxplot()
g_f_mpt
#| label: son_per_f_mpt
son_per_f_mpt <- father_son_ht |>
group_by(f_ivl, f_mpt) |>
summarise(
s_count = n(),
s_min   = min(son, na.rm = TRUE),
s_max   = max(son, na.rm = TRUE),
s_avg   = mean(son, na.rm = TRUE)
)
son_per_f_mpt |> print(digits = 1)
#| label: diamonds
# make your own copy of the diamond data
diamonds <- ggplot2::diamonds
#| label: gss_cat
# make your own copy of the survey data
gss_cat <- forcats::gss_cat
#| label: height_per_fs
# render "father" and "son" as levels of factor "fs"
height_per_fs <- father_son_ht |>
# continue to identify father-son pairs
mutate(idx = 1:nrow(father_son_ht)) |>
dplyr::select(idx, father, son) |>
pivot_longer(
cols = c(father, son),
names_to = "fs",
values_to = "height"
)
#| label: g_ht_per_fs
g_ht_per_fs <- height_per_fs |>
ggplot(mapping = aes(x = fs |> as_factor(), y = height)) +
geom_boxplot()
g_ht_per_fs
#| label: ht_per_fs__summarise
fs_smy <- height_per_fs |> dplyr::select(fs, height) |>
group_by(fs) |>
summarise(
min = min(height),
mid = median(height),
avg = mean(height),
max = max(height)
)
fs_smy |> print(digits = 1)
#| label: s_minus_f
father_son_ht <- father_son_ht |>
mutate(s_minus_f = son - father)
#| label: s_minus_f__hist
g_s_minus_f <- father_son_ht |>
ggplot(mapping = aes(x = s_minus_f)) +
geom_histogram()
g_s_minus_f
#| label: s_minus_f__smy
father_son_ht$s_minus_f |>
summary() |>
print(digits = 1)
#| label: fig-ht-per-fs
#| fig-cap: "Overall, the sons are taller"
g_ht_per_fs <- height_per_fs |>
ggplot2::ggplot(mapping = aes(x = fs |> as_factor(), y = height)) +
ggplot2::geom_boxplot() +
ggplot2::labs(title = "Sons are generally taller than fathers") +
ggplot2::xlab("")
g_ht_per_fs
#| label: fig-s-minus-f
#| fig-cap: "Histogram of son's height minus father's height"
g_s_minus_f <- father_son_ht |>
ggplot2::ggplot(mapping = aes(x = s_minus_f)) +
ggplot2::geom_histogram() +
ggplot2::labs(title = "Difference of son's height minus father's height") +
ggplot2::xlab("height difference in inches: son's minus father's")
g_s_minus_f
