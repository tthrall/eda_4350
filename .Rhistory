#   .. .. ..@ prefix       : chr "C:\\Users\\tthra\\AppData\\Local\\Temp\\Rtmpii0FrX\\file3809f25778"
#   .. .. ..@ save         : int 0
#   .. .. ..@ nstart       : int 1
#   .. .. ..@ best         : logi TRUE
#   .. .. ..@ keep         : int 0
#   .. .. ..@ estimate.beta: logi TRUE
