))
# inspect result: city identifiers (w/o Region)
# city_slices |> dplyr::select(slice, Country:City)
# # A tibble: 7 × 4
#   slice     Country  State                City
#   <chr>     <chr>    <chr>                <chr>
# 1 days_min  Germany  NA                   Bonn
# 2 days_max  US       District of Columbia Washington
# 3 days_max  US       Maryland             Washington DC
# 4 t_avg_min US       Alaska               Fairbanks
# 5 t_avg_max Nigeria  NA                   Niamey
# 6 t_sd_min  Colombia NA                   Bogota
# 7 t_sd_max  Mongolia NA                   Ulan-bator
# inspect result: dates
# NB: two entries for Washington DC, each with dup data
# city_slices |> dplyr::select(slice, City:dt_max)
# # A tibble: 7 × 6
#   slice     City          n_days n_miss dt_min     dt_max
#   <chr>     <chr>          <int>  <int> <date>     <date>
# 1 days_min  Bonn            3133   2050 1995-01-01 2003-07-30
# 2 days_max  Washington     18530     32 1995-01-01 2020-05-13
# 3 days_max  Washington DC  18530     32 1995-01-01 2020-05-13
# 4 t_avg_min Fairbanks       9265     12 1995-01-01 2020-05-13
# 5 t_avg_max Niamey          9266    201 1995-01-01 2020-05-13
# 6 t_sd_min  Bogota          9266     70 1995-01-01 2020-05-13
# 7 t_sd_max  Ulan-bator      9266     45 1995-01-01 2020-05-13
# inspect result: temperatures
# city_slices |> dplyr::select(slice, City, t_avg, t_sd)
# # A tibble: 7 × 4
#   slice     City          t_avg  t_sd
#   <chr>     <chr>         <dbl> <dbl>
# 1 days_min  Bonn           51.8 13.4
# 2 days_max  Washington     58.5 16.8
# 3 days_max  Washington DC  58.5 16.8
# 4 t_avg_min Fairbanks      28.5 28.5
# 5 t_avg_max Niamey         86.0  6.72
# 6 t_sd_min  Bogota         56.4  1.84
# 7 t_sd_max  Ulan-bator     30.3 28.9
city_slices |> dplyr::select(slice, Country:City)
city_slices |> dplyr::select(slice, City:dt_max)
city_slices |> dplyr::select(slice, City, t_avg, t_sd)
