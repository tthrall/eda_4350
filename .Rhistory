#| label: NB10-stats
NB10_stats <- NB10_long |>
summarise(
avg = mean(deficit, na.rm = TRUE),
sd  = sd(deficit, na.rm = TRUE)
)
#| label: NB10-z-score
NB10_z_score <- NB10_long |>
dplyr::mutate(
z_score = (deficit - NB10_stats$avg)/NB10_stats$sd
)
#| label: NB10-normal-approx
NB10_normal_approx <- tibble::tibble(
z = seq(
from = min(NB10_z_score$ z_score, na.rm = TRUE),
to   = max(NB10_z_score$ z_score, na.rm = TRUE),
length.out = 1000
),
d = dnorm(z)
)
#| label: fig-NB10-z-score
#| fig-cap: "NB10: z-scores and standard normal curve"
g_NB10_z_score <- NB10_z_score |>
ggplot(mapping = aes(x = z_score)) +
stat_density(geom = "area", outline.type = "both") +
geom_histogram(fill = "blue", stat = "density") +
labs(
title = "NB10: z-scores and standard normal curve"
) +
geom_line(
data = NB10_normal_approx,
mapping = aes(
x = z, y = d,
colour = "red"
),
show.legend = FALSE
)
g_NB10_z_score
stats::pnorm(-6, log.p = TRUE)
q_6_ln <- - stats::pnorm(-6, log.p = TRUE)
(q_6_log_10 <- q_6_ln |> exp() |> log10())
cum_condl_z <- function(z_0 = 6, delta = 3, by = 0.1) {z_tbl <- tibble(z = seq(z_0, z_0 + delta, by = by), p_cum_lr = pnorm(z, log.p = TRUE) - pnorm(z_0, log.p = TRUE)); return(z_tbl)}
cum_condl_z()
cum_condl_z <- function(z_0 = 6, delta = 3, by = 0.1) {z_tbl <- tibble(z = seq(z_0, z_0 + delta, by = by), p_cum_lr = pnorm(- z, log.p = TRUE) - pnorm(- z_0, log.p = TRUE)); return(z_tbl)}
cum_condl_z()
cum_condl_z <- function(z_0 = 6, delta = 3, by = 0.1) {z_tbl <- tibble(z = seq(z_0, z_0 + delta, by = by), lr = pnorm(- z, log.p = TRUE) - pnorm(- z_0, log.p = TRUE), ratio = exp(lr); p_cum - 1 - ratio); return(z_tbl)}
cum_condl_z <- function(z_0 = 6, delta = 3, by = 0.1) {z_tbl <- tibble(z = seq(z_0, z_0 + delta, by = by), lr = pnorm(- z, log.p = TRUE) - pnorm(- z_0, log.p = TRUE), ratio = exp(lr), p_cum - 1 - ratio); return(z_tbl)}
cum_condl_z()
cum_condl_z <- function(z_0 = 6, delta = 3, by = 0.1) {z_tbl <- tibble(z = seq(z_0, z_0 + delta, by = by), lr = pnorm(- z, log.p = TRUE) - pnorm(- z_0, log.p = TRUE), ratio = exp(lr), p_cum = 1 - ratio); return(z_tbl)}
cum_condl_z()
