#| label: tp_1_1_sim
set.seed(12345)
# 150 observations
x <- sarima.sim(ar = .5, ma = 0.5, n = 150)
# use first 100 to forecast
y <- window(x, start = 1, end = 100)
sarima.for(y, n.ahead = 50, p = 1, q = 1, plot.all = TRUE)
text(85, 375, "PAST"); text(115, 375, "FUTURE")
abline(v = 100, lty = 2, col = 4)
lines(x)
#| label: tp_1_1_sim
set.seed(12345)
# 150 observations
x <- sarima.sim(ar = .5, ma = 0.5, n = 150)
# use first 100 to forecast
y <- window(x, start = 1, end = 100)
sarima.for(y, n.ahead = 50, p = 1, d = 0, q = 1, plot.all = TRUE)
text(85, 375, "PAST"); text(115, 375, "FUTURE")
abline(v = 100, lty = 2, col = 4)
lines(x)
#| label: tp_1_1_sim
set.seed(12345)
# 150 observations
x <- sarima.sim(ar = .5, ma = 0.5, n = 150)
# use first 100 to forecast
y <- x |> window(start = 1, end = 100)
y |> sarima.for(
n.ahead = 50, p = 1, d = 0, q = 1, plot.all = TRUE, ylab = "N"
)
text(85, 375, "PAST"); text(115, 375, "FUTURE")
abline(v = 100, lty = 2, col = 4)
lines(x)
#| label: tp_1_1_sim
set.seed(12345)
# 150 observations
x <- astsa::sarima.sim(ar = .5, ma = 0.5, n = 150)
# use first 100 to forecast
y <- x |> stats::window(start = 1, end = 100)
y |> astsa::sarima.for(
n.ahead = 50, p = 1, d = 0, q = 1, plot.all = TRUE, ylab = "N"
)
graphics::text(85, 375, "PAST"); text(115, 375, "FUTURE")
graphics::abline(v = 100, lty = 2, col = 4)
graphics::lines(x)
#| label: tp_1_1_sim
set.seed(12345)
# 150 observations
x <- astsa::sarima.sim(ar = .5, ma = 0.5, n = 150)
# use first 100 to forecast
y <- x |> stats::window(start = 1, end = 100)
# capture the forecast output
tp_1_0_1_sim <- y |> astsa::sarima.for(
n.ahead = 50, p = 1, d = 0, q = 1, plot.all = TRUE, ylab = "N"
)
graphics::text(85, 375, "PAST"); text(115, 375, "FUTURE")
graphics::abline(v = 100, lty = 2, col = 4)
graphics::lines(x)
#| label: tp_1_1_sim
set.seed(12345)
# 150 observations
x <- astsa::sarima.sim(ar = .5, ma = 0.5, n = 150)
# use first 100 to forecast
y <- x |> stats::window(start = 1, end = 100)
# capture the predictions and standard errors
tp_1_0_1_sim <- y |> astsa::sarima.for(
n.ahead = 50, p = 1, d = 0, q = 1, plot.all = TRUE, ylab = "N"
)
graphics::text(85, 375, "PAST"); text(115, 375, "FUTURE")
graphics::abline(v = 100, lty = 2, col = 4)
graphics::lines(x)
#| label: tp_1_1_sim
set.seed(12345)
# 150 observations
x <- astsa::sarima.sim(ar = .5, ma = 0.5, n = 150)
# use first 100 to forecast
y <- x |> stats::window(start = 1, end = 100)
# capture the predictions and standard errors
tp_1_0_1_sim <- y |> astsa::sarima.for(
n.ahead = 50, p = 1, d = 0, q = 1, plot.all = TRUE, ylab = "N"
)
graphics::abline(v = 100, lty = 2, col = 4)
graphics::lines(x)
root2 <- function(a, b, c) {base <- -b; d <- b^2 - 4*a*c; pm <- sqrt(abs(d)); if (d < 0) pm <- pm * (0+1i); return(c(base + pm, base - pm)/(2 * a))}
root2(1, 2, 1)
root2(1, 0, 1)
root2(0.46, -1.35, 1)
#| label: fig-soi-AR-2
#| fig-cap: "Recruitment index followed by a 24-month AR(2) forecast"
# fit AR(2)
regr <- astsa::rec |> stats::ar.ols(order=2, demean=FALSE, intercept=TRUE)
fore = stats::predict(regr, n.ahead=24)
x = ts( c(rec, fore$pred), start=1950, frequency=12)
tsplot(window(x, start=1980), ylab="Recruitment", ylim=c(10,100))
lines(fore$pred, type="o", col=2)
U = fore$pred+fore$se
L = fore$pred-fore$se
xx = c(time(U), rev(time(U)))
yy = c(L, rev(U))
polygon(xx, yy, border = 8, col = gray(0.6, alpha = 0.2))
#| label: fig-soi-AR-2
#| fig-cap: "Recruitment index followed by a 24-month AR(2) forecast"
# fit AR(2) to recruitment data
regr <- astsa::rec |> stats::ar.ols(
order = 2, demean = FALSE, intercept = TRUE
)
# forecast 24 months beyond data
fore = regr |> stats::predict(n.ahead = 24)
x = ts( c(rec, fore$pred), start=1950, frequency=12)
tsplot(window(x, start=1980), ylab="Recruitment", ylim=c(10,100))
lines(fore$pred, type="o", col=2)
U = fore$pred+fore$se
L = fore$pred-fore$se
xx = c(time(U), rev(time(U)))
yy = c(L, rev(U))
polygon(xx, yy, border = 8, col = gray(0.6, alpha = 0.2))
#| label: fig-soi-AR-2
#| fig-cap: "Recruitment index followed by a 24-month AR(2) forecast"
# fit AR(2) to recruitment data
regr <- astsa::rec |> stats::ar.ols(
order = 2, demean = FALSE, intercept = TRUE
)
# forecast 24 months beyond data
fore = regr |> stats::predict(n.ahead = 24)
# append predictions to data in time series x
x <- ts( c(rec, fore$pred), start=1950, frequency=12)
# plot x
astsa::tsplot(window(x, start=1980), ylab="Recruitment", ylim=c(10,100))
lines(fore$pred, type="o", col=2)
U = fore$pred+fore$se
L = fore$pred-fore$se
xx = c(time(U), rev(time(U)))
yy = c(L, rev(U))
polygon(xx, yy, border = 8, col = gray(0.6, alpha = 0.2))
#| label: fig-soi-AR-2
#| fig-cap: "Recruitment index followed by a 24-month AR(2) forecast"
# fit AR(2) to recruitment data
regr <- astsa::rec |> stats::ar.ols(
order = 2, demean = FALSE, intercept = TRUE
)
# forecast 24 months beyond data
fore <- regr |> stats::predict(n.ahead = 24)
# append predictions to data in time series x
x <- ts(
c(rec, fore$pred),
start = 1950,
frequency = 12
)
# plot x
stats::window(x, start=1980) |>
astsa::tsplot(
lab = "Recruitment",
ylim = c(10,100)
)
# plot predictions
graphics::lines(fore$pred, type = "o", col = 2)
# confidence bounds
U <- fore$pred + fore$se
L <- fore$pred - fore$se
# confidence region
xx <- c(
stats::time(U),
rev(stats::time(U))
)
yy <- c(L, rev(U))
graphics::polygon(
xx, yy,
border = 8,
col = gray(0.6, alpha = 0.2)
)
