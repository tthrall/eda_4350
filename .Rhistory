par(mfrow=2:1)
g_jj <- astsa::tsplot(
jj,
col=4,
ylab="USD",
type="o")
g_jj_log <- astsa::tsplot(
jj, col=4, ylab="USD", type="o", log="y")
#| label: fig-gtemp-lo
#| fig-cap: "Deviations in global surface temperatures"
g_temp_lo <- astsa::tsplot(
cbind(gtemp_land, gtemp_ocean),
spaghetti=TRUE,
col=astsa.col(c(4,2),.7),
pch=c(20,18),
