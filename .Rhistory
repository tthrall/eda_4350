) |>
dplyr::mutate(
tag = case_when(
var == "W" ~ "wn",
var == "X" ~ "AR_1",
var == "Y" ~ "MA_1",
var == "Z" ~ "ARMA_1_1")
) |>
dplyr::select(freq, var, tag, spec)
#| label: fig-ARMA-spec
#| fig-cap: "Spectral density function of each ARMA model"
g_arma_spec <- arma_spec_long |>
dplyr::group_by(var) |>
ggplot2::ggplot(mapping = aes(
x = freq, y = spec, color = var, fill = var
)) +
ggplot2::geom_line(show.legend = FALSE) +
ggplot2::facet_grid(
rows   = vars(var),
scales = "free_y"
) +
ggplot2::labs(
title = "Spectral density of simple ARMA models",
subtitle = "W ~ White Noise, X ~ AR(1), Y ~ MA(1), Z ~ ARMA(1, 1)"
) +
ggplot2::ylab("spectral density")
g_arma_spec
#| label: sunspot-spec-list
sunspot_spec_lst <-
datasets::sunspot.month |>
fmt_spec_pgram(
taper = 1/4, spans = c(9, 9))
sunspot_spec_tbl <-
sunspot_spec_lst$ freq_spec_tbl |>
# change cycles per year to cycles per month
dplyr::mutate(freq = freq/12)
sunspot_spec_stats <-
sunspot_spec_lst$ spec_scalars
# frequency of peak in spectrum
sun_spec_peak_slice <-
sunspot_spec_tbl |>
dplyr::slice_max(spec, n = 1)
peak_freq    <- sun_spec_peak_slice$ freq
peak_wave_mo <- 1 / peak_freq
peak_wave_yr <- peak_wave_mo / 12
#| label: fig-sunspot-spec
#| fig-cap: "Monthly sunspot numbers: estimated spectral density"
g_sunspot_spec <- sunspot_spec_tbl |>
ggplot2::ggplot(mapping = aes(
x = freq, y = spec
)) +
ggplot2::geom_line() +
ggplot2::labs(
title = "Monthly sunspot numbers",
subtitle = "Estimated spectral density function") +
ggplot2::xlab("freq = cycles per month") +
ggplot2::ylab("spectral density")
g_sunspot_spec
#| label: fig-sunspot-spec_log10
#| fig-cap: "Sunspot spectral density: zoom-in view"
g_sunspot_spec <- sunspot_spec_tbl |>
dplyr::filter(freq < 0.05) |>
ggplot2::ggplot(mapping = aes(
x = freq, y = log10(spec)
)) +
ggplot2::geom_line() +
ggplot2::labs(
title = "Sunspot spectral density function",
subtitle = "zoom-in view") +
ggplot2::xlab("freq = cycles per month") +
ggplot2::ylab("log_10( spectral density )")
g_sunspot_spec
