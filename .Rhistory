#| label: mk-tbl
# run kmeans on college data for successive values of k
# to ensure reproducibility, set random seed
set.seed(42)
k_max <- 12L
nstart_per_k <- 20L
mk_tbl <- tibble::tibble()
coll_z <- college_z_scores |>
# use only z-scores of original numeric variables
dplyr::select(- grp_lbl)
for (k in 2:k_max) {
m_tmp <- coll_z |>
kmeans(centers = k, nstart = nstart_per_k)
mk_tbl <- mk_tbl |>
dplyr::bind_rows(
tibble::tibble(
k    = k,
wcss = m_tmp$ tot.withinss)
)
}
#| label: fig-mk-tbl
#| fig-cap: "Within-cluster sum of squares versus number of clusters"
g_mk_tbl <- mk_tbl |>
ggplot2::ggplot(mapping = aes(
x = k, y = wcss
)) +
ggplot2::scale_x_continuous(
name = NULL,
breaks = seq(2, 12, 2)) +
ggplot2::geom_line() +
ggplot2::labs(
title = "WCSS versus K for college z-scores",
subtitle = "(nstart = 20)") +
ggplot2::xlab("K")
g_mk_tbl
#| label: fig-mk-tbl
#| fig-cap: "Within-cluster sum of squares versus number of clusters"
g_mk_tbl <- mk_tbl |>
ggplot2::ggplot(mapping = aes(
x = k, y = wcss
)) +
ggplot2::scale_x_continuous(
name = "K",
breaks = seq(2, 12, 2)) +
ggplot2::geom_line() +
ggplot2::labs(
title = "WCSS versus K for college z-scores",
subtitle = "(nstart = 20)") +
ggplot2::xlab("K")
g_mk_tbl
