ar = phi_sim, innov = W),
Y   = astsa::sarima.sim(n = n_sim, burnin = 0L,
ma = theta_sim, innov = W),
Z   = astsa::sarima.sim(n = n_sim, burnin = 0L,
ar = phi_sim, ma = theta_sim, innov = W)
)
#| label: ARMA-sim-long
sim_long <- sim_tbl |>
tidyr::pivot_longer(
cols = W:Z,
names_to = "var"
) |>
dplyr::mutate(
tag = case_when(
var == "W" ~ "wn",
var == "X" ~ "AR_1",
var == "Y" ~ "MA_1",
var == "Z" ~ "ARMA_1_1")
) |>
dplyr::select(idx, var, tag, value)
#| label: fig-ARMA-sim-ts
#| fig-cap: "ARMA simulation"
g_sim_long <- sim_long |>
dplyr::group_by(var) |>
ggplot2::ggplot(mapping = aes(
x = idx, y = value, color = var, fill = var
)) +
ggplot2::geom_line(show.legend = FALSE) +
ggplot2::facet_grid(
rows   = vars(var),
