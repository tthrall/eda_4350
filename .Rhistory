X   = astsa::sarima.sim(n = n_sim, ar = phi_sim),
Y   = astsa::sarima.sim(n = n_sim, ma = theta_sim),
Z   = astsa::sarima.sim(n = n_sim, ar = phi_sim, ma = theta_sim)
)
#| label: ARMA-sim
set.seed(seed_sim)
sim_tbl <- tibble::tibble(
idx = 1:n_sim,
W   = astsa::sarima.sim(n = n_sim),
