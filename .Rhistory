#| label: alpha-nrm-ln
# acceptance log-ratio for standard normal density
alpha_nrm_ln <- function(
y, # <dbl> candidate for next value
x  # <dbl> current value
) {
min(dnorm(y, log = TRUE) - dnorm(x, log = TRUE), 0)
}
#| label: Met-algo-nrm
# generate a standard normal random walk
gen_nrw <- function(
delta = 0.25,  # <dbl> max jump-size
n_pts = 1024L, # <int> sequence length
x_0   = 0        # <dbl> starting value
) {
x <- vector(mode = "numeric", length = n_pts)
x [[1]] <- x_0
eps  <- runif(n_pts, -delta, delta)
u_ln <- runif(n_pts) |> log()
for (k in 2:n_pts) {
y <- x [[k - 1L]] + eps [[k]]
if ( u_ln [[k]] <= alpha_nrm_ln( y, x[[k - 1L]] )) {
x [[k]] <- y
} else {
x [[k]] <- x [[k - 1L]]
}
}
return(x)
}
#| label: normal-rw
set.seed(97)
nrm_rw_wide <- tibble::tibble(
x_01  = gen_nrw(delta = 0.1),
x_10  = gen_nrw(delta = 1.0),
t_idx = 1:length(x_01)
) |>
dplyr::select(t_idx, x_01, x_10)
nrm_rw_long <- nrm_rw_wide |>
tidyr::pivot_longer(
cols = x_01:x_10,
names_to = "d_chr",
names_prefix = "x_",
values_to = "value"
)
#| label: fig-nrw-hist
#| fig-cap: "Normal random walks with ssmall and large jumps)"
g_hist_nrm_rw <- nrm_rw_long |>
dplyr::group_by(d_chr) |>
dplyr::rename(
time = t_idx,
z = value,
delta = d_chr
) |>
ggplot2::ggplot(mapping = aes(
x = z, fill = delta, color = delta
)) +
ggplot2::geom_histogram(show.legend = FALSE) +
ggplot2::facet_grid(
rows = vars(delta)
) +
ggplot2::labs(
title = "Normal random walks"
)
g_hist_nrm_rw
