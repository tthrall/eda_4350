n = n_sim, ar = phi_sim, innov = W),
Y   = astsa::sarima.sim(
n = n_sim, ma = theta_sim, innov = W),
Z   = astsa::sarima.sim(
n = n_sim, ar = phi_sim, ma = theta_sim, innov = W)
)
#| label: ARMA-sim-long
sim_long <- sim_tbl |>
tidyr::pivot_longer(
cols = X:Z,
names_to = "var"
) |>
dplyr::mutate(
tag = case_when(
var == "W" ~ "wn",
var == "X" ~ "AR_1",
var == "Y" ~ "MA_1",
var == "Z" ~ "ARMA_1_1")
)
