"data", "retain", "ap_topics.txt"
))
}
# ap_topics |> object.size(): 1.1 MB
# 1128400 bytes
ap_topics |> print(n = 4, digits = 2)
#| label: ap-top-terms
ap_top_terms <- ap_topics |>
dplyr::slice_max(beta, n = 10, by = "topic")
#| label: ap-top-terms-wide
# afterthought: display bar chart, not this table
ap_top_terms_1 <- ap_top_terms |>
dplyr::filter(topic == 1L)
ap_top_terms_2 <- ap_top_terms |>
dplyr::filter(topic == 2L)
ap_top_terms_wide <- tibble::tibble(
rank    = 1:nrow(ap_top_terms_1),
topic_1 = ap_top_terms_1$ term,
topic_2 = ap_top_terms_2$ term
)
#| label: fig-ap-top-terms
#| fig-cap: "AP articles: most probable terms by topic"
g_ap_top_terms <- ap_top_terms |>
dplyr::mutate(term = reorder_within(
x = term,
by = beta,
within = topic)) |>
ggplot2::ggplot(mapping = aes(
x = beta, y = term, fill = factor(topic)
)) +
ggplot2::geom_col(show.legend = FALSE) +
ggplot2::facet_wrap(~ as_factor(topic), scales = "free") +
ggplot2::scale_y_reordered() +
ggplot2::labs(title = "AP articles: most probable terms by topic")
g_ap_top_terms
#| label: beta-ratio-wide
beta_ratio_wide <- ap_topics |>
dplyr::mutate(topic = paste0("beta_", topic)) |>
tidyr::pivot_wider(names_from = topic, values_from = beta) |>
dplyr::filter(
pmin(beta_1, beta_2) > 0,
pmax(beta_1, beta_2) > 0.001
) |>
dplyr::mutate(log_ratio = log2(beta_2 / beta_1))
#| label: fig-beta-ratio-wide
#| fig-cap: "Log2 ratio of beta in topic 2 / topic 1"
g_beta_ratio_wide <- beta_ratio_wide |>
dplyr::group_by(direction = log_ratio > 0) |>
dplyr::slice_max(abs(log_ratio), n = 10) |>
dplyr::ungroup() |>
dplyr::mutate(term = reorder(term, log_ratio)) |>
ggplot2::ggplot(aes(log_ratio, term)) +
ggplot2::geom_col() +
ggplot2::labs(x = "Log2 ratio of beta in topic 2 / topic 1", y = NULL)
g_beta_ratio_wide
#| label: fig-ap-top-terms
#| fig-cap: "AP articles: most probable terms by topic"
g_ap_top_terms <- ap_top_terms |>
dplyr::mutate(term = reorder_within(
x = term,
by = beta,
within = topic)) |>
ggplot2::ggplot(mapping = aes(
x = beta, y = term, fill = factor(topic)
)) +
ggplot2::geom_col(show.legend = FALSE) +
ggplot2::facet_wrap(~ as_factor(topic), scales = "free") +
tidytext::scale_y_reordered() +
ggplot2::labs(title = "AP articles: most probable terms by topic")
g_ap_top_terms
