#   ..@ iter           : int 2000
#   ..@ logLiks        : num(0)
#   ..@ n              : int 717
af_bbb_vocab_ct [[3]]
af_bbb_vocab_ct [[3]]
af_bbb_vocab_ct [[3, 2]]
af_bbb_gs <- af_bbb_dtm_lst |>
topicmodels::LDA(
# number of topics
k = 2,
method = "Gibbs",
# set seed to ensure results can be reproduced
control = list(seed = 1234)
)
af_bbb_word_tally <- tibble::tibble(
obj  = c(
"af_bbb_token_tbl",
"af_bbb_gs",
"af_bbb_vocab_wt",
"af_bbb_tf_tbl",
"af_bbb_vocab_lst",
"af_bbb_gs"
),
elt  = c("word", "z", "wt", "count", "af_bbb_vocab", "terms"),
len  = c(
af_bbb_token_tbl$ word         |> length(),
af_bbb_gs@ z                   |> length(),
af_bbb_vocab_wt$ wt            |> length(),
af_bbb_tf_tbl$ count           |> length(),
af_bbb_vocab_lst$ af_bbb_vocab |> length(),
af_bbb_gs@ terms               |> length()
))
af_bbb_word_tally
(tst_mat <- c(1, 2, 5, 11) %o% c(1, 3, 7))
tst_mat |> t()
af_bbb_gs@ wordassignments$ i |> as_factor() |> summary()
af_bbb_gs@ wordassignments$ j |> summary()
af_bbb_gs@ wordassignments$ v |> as_factor() |> summary()
