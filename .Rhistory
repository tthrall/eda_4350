g_f_mpt <- father_son_ht |>
dplyr::filter(! is.na(f_mpt)) |>
ggplot2::ggplot(mapping = aes(
x = f_mpt |> as_factor(),
y = son
)) +
ggplot2::geom_boxplot() +
ggplot2::labs(title = "Son heights per father's height") +
ggplot2::xlab("father's height rounded to nearest odd inch") +
