g_s_avg_per_f_mpt
#| label: fig-fs-lines
#| fig-cap: "Father-son heights: regression line and SD line"
SD_slope = fs_moments[["s_sd"]] / fs_moments[["f_sd"]]
R_slope  = fs_moments[["r"]] * SD_slope
g_fs_lines <- g_fs_points +
# SD line
geom_abline(
slope = SD_slope,
intercept =
fs_moments[["s_avg"]] - SD_slope * fs_moments[["f_avg"]],
linetype = "dotted",
linewidth = 2,
color = "red"
) +
# Regression line
geom_abline(
slope = R_slope,
intercept =
fs_moments[["s_avg"]] - R_slope * fs_moments[["f_avg"]],
linetype = "solid",
linewidth = 2,
color = "blue"
) +
labs(
title = "Father-son heights",
subtitle = "Regression line (solid blue), SD line (dotted red)"
)
g_fs_lines
#| label: fig-fs-residuals
#| fig-cap: "Variation of son heights from regression line"
# histogram of residuals
g_fs_residuals <- fs_residuals |>
ggplot(mapping = aes(x = residual)) +
geom_histogram() +
labs(
title = "Histogram of regression residuals",
subtitle = "son's height minus predicted height"
)
g_fs_residuals
#| label: fig-resid-son
#| fig-cap: "Model-fitted value versus son's height"
# scatter diagram with (x, y) = (son, fitted)
g_resid_son <- fs_residuals |>
ggplot2::ggplot(mapping = aes(
x = son, y = fitted_value
)) +
ggplot2::geom_point() +
ggplot2::geom_abline(
intercept = 0,
slope = 1,
linetype = "dotted",
linewidth = 2,
colour = "red"
) +
ggplot2::labs(
title = "Model-fitted value versus son's height",
subtitle = "(reference line: fitted = son)") +
ggplot2::xlab("son's height in inches") +
ggplot2::ylab("son's height estimated from father's height")
g_resid_son
