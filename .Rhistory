#| label: ARMA-sim-spec-dens
spec_W_lst <- W |> spec.pgram(detrend = FALSE, plot = FALSE, taper = 1/8)
freq_sim   <- spec_W_lst$ freq
spec_W     <- spec_W_lst$ spec
# extract estimated spectral density from listed results
spec_strip <- function(
x # univariate time series
) {
spec_lst <- x |>
spec.pgram(
detrend = FALSE,
plot    = FALSE,
taper   = 1/8)
return(spec_lst$ spec)
}
spec_sim <- sim_tbl |>
dplyr::mutate(across(
.cols = W:Z,
.fns = spec_strip
)) |>
dplyr::mutate(freq = freq_sim) |>
dplyr::select(freq, everything())
