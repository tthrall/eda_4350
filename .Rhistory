#| label: CRAN-libraries
library(assertthat)
library(GGally)
library(gutenbergr)
library(here)
library(ISLR2)
library(janeaustenr)
library(latex2exp)
library(quanteda)
library(tidytext)
library(tidyverse)
library(tinytex)
library(tm)
library(tokenizers)
# library(topicmodels)
library(tufte)
# package topic models available?
topicmodels_loaded <- require(topicmodels)
#| label: local-source
source(here("code", "rmse_per_grp.R"))
source(here("code", "xtabs_to_jaccard.R"))
#| label: sound-fury
sound_fury <- c("Life's but a walking shadow, a poor player ",
"That struts and frets his hour upon the stage, ",
"And then is heard no more: it is a tale ",
"Told by an idiot, full of sound and fury, ",
"Signifying nothing.")
sound_fury
#| label: lst-sf-line-tbl
#| lst-cap: ""
#| echo: true
sf_line_tbl <- tibble::tibble(
l_idx = 24:28,
line  = sound_fury
)
sf_line_tbl
#| label: lst-sf-token-tbl
#| lst-cap: ""
#| echo: true
sf_token_tbl <- sf_line_tbl |>
tidytext::unnest_tokens(
input  = "line",
output = "word"
)
sf_token_tbl
#| label: lst-sf-tokens-xsw
#| lst-cap: ""
#| echo: true
sf_tokens_xsw <- sf_token_tbl |>
anti_join(
y  = tidytext::stop_words,
by = "word"
)
sf_tokens_xsw
#| label: ja-strings-per-book
ja_strings_per_book <- janeaustenr::austen_books() |>
dplyr::summarise(
.by = book,
n_strings = n()
)
ja_strings_per_book
#| label: ja-plus-chapters
# new columns per book: line number, chapter
ja_plus_chapters <- janeaustenr::austen_books() |>
dplyr::mutate(
.by        = book,
linenumber = dplyr::row_number(),
chapter    = cumsum(
stringr::str_detect(
text,
regex(
"^chapter [\\divxlc]",
ignore_case = TRUE)
))
)
#| label: ja-words-raw
# break each line of text into several rows of words
ja_words_raw <- ja_plus_chapters |>
tidytext::unnest_tokens(
input  = text,
output = word
)
#| label: ja-words-xsw
# remove stop-words
ja_words_xsw <- ja_words_raw |>
dplyr::anti_join(
y  = tidytext::stop_words,
by = "word")
#| label: ja-word-ct
# count the number of occurrences of each word
# list largest counts first
ja_word_ct <- ja_words_xsw |>
dplyr::count(word, sort = TRUE)
#| label: tbl-ja-word-ct
#| tbl-cap: "Jane Austen: frequent (non-stop) words"
ja_word_ct |>
dplyr::slice_head(n = 10) |>
knitr::kable(
caption = "Jane Austen: 10 most common (non-stop) words",
col.names = c("word", "count")
)
#| label: hgwells-books
hgwells_books <- tibble::tribble(
~id, ~title,
35L, "The Time Machine",
36L, "The War of the Worlds",
5230L, "The Invisible Man",
159L, "The Island of Doctor Moreau"
)
hgwells_books
#| label: hgwells-lines
hgwells_lines <- NULL
# load file as tibble by one of these methods
uncl_download <- FALSE
load_rda      <- FALSE
read_tsv      <- TRUE
if (uncl_download) {
hgwells_lines <- gutenberg_download(
gutenberg_id = hgwells_books$ id)
} else {
if (load_rda) {
load(here::here("data", "rda", "hgwells.rda"))
hgwells_lines <- hgwells
rm(hgwells)
} else {
if (read_tsv) {
hgwells_lines <- readr::read_tsv(here::here(
"data", "retain", "hgwells_lines.txt"
))
}
}
}
# save as text file only as needed
save_file <- FALSE
if (
save_file &&
(! is.null(hgwells_lines))
) {
hgwells_lines |> readr::write_tsv(here::here(
"data", "retain", "hgwells_lines.txt"
))
}
#| label: hgwells-words
# break each line into rows, one word per row
hgwells_words <- hgwells_lines |>
tidytext::unnest_tokens(
input  = text,
output = word
) |>
# remove stop-words
anti_join(
y  = tidytext::stop_words,
by = "word")
#| label: save-hgwells-books
# save as text only as needed
save_file <- FALSE
if (save_file) {
hgwells_words |> write_tsv(
here("data", "retain", "hgwells_words.txt")
)
}
#| label: hgwells-word-ct
hgwells_word_ct <- hgwells_words |>
dplyr::count(word, sort = TRUE)
#| label: tbl-hgwells-word-ct
#| tbl-cap: "H.G. Wells: frequent (non-stop) words"
hgwells_word_ct |>
dplyr::slice_head(n = 10) |>
knitr::kable(
caption = "H.G. Wells: 10 most common (non-stop) words",
col.names = c("word", "count")
)
#| label: ja-book-wd-ct
# count (book, word) occurrences
# including stop-words
ja_book_wd_ct <- ja_words_raw |>
# n = number of (book, word) occurrences
dplyr::count(book, word)
#| label: ja-tf-idf
# calculate (tf, idf, tf-idf)
ja_tf_idf <- ja_book_wd_ct |>
tidytext::bind_tf_idf(word, book, n) |>
arrange(book, desc(tf_idf))
#| label: ja-max-wd-per-book
# use max tf-idf to find the most distinctive word per book
ja_max_wd_per_book <- ja_tf_idf |>
group_by(book) |>
filter(tf_idf == max(tf_idf, na.rm = TRUE))
#| label: tbl-ja-max-wd-per-book
#| tbl-cap: "Jane Austen: max tf-idf word per book"
ja_max_wd_per_book |>
knitr::kable(
caption = "Max tf-idf word per book",
digits = 3
)
